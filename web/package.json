{
  "name": "git-iterm2-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern src tests e2e",
    "format": "prettier --no-error-on-unmatched-pattern --write src tests e2e *.ts *.js *.json",
    "format:check": "prettier --no-error-on-unmatched-pattern --check src tests e2e *.ts *.js *.json",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/api/types.gen.ts",
    "check:types-current": "node scripts/check-types-current.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.3",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
